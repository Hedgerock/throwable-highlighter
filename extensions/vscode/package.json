{
  "name": "throwable-highlighter",
  "displayName": "Throwable Highlighter",
  "description": "Throwable Highlighter for VS Code.",
  "version": "0.1.0",
  "icon": "icon.png",
  "private": true,
  "publisher": "hedgerock",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedgerock/throwable-highlighter.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onCommand:throwableHighlighter.inspectDefinition",
    "onCommand:throwableHighlighter.openColorSettings",
    "onCommand:throwableHighlighter.openDiagnostics"
  ],
  "main": "./out/extension.js",
  "web-types": "./web-types.json",
  "contributes": {
    "commands": [
      {
        "command": "throwableHighlighter.inspectDefinition",
        "title": "Throwable Highlighter: Inspect Definition"
      },
      {
        "command": "throwableHighlighter.openColorSettings",
        "title": "Throwable Highlighter: Open Color Settings"
      },
      {
        "command": "throwableHighlighter.openDiagnostics",
        "title": "Throwable Highlighter: Open Diagnostics"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "throwableHighlighter.inspectDefinition",
          "when": "editorLangId == java && throwableHighlighter.inspectDefinitionAvailable"
        }
      ],
      "extension/context": [
        {
          "command": "throwableHighlighter.openColorSettings",
          "when": "extension == 'hedgerock.throwable-highlighter'",
          "group": "2_configure@1"
        }
      ]
    },
    "configuration": {
      "title": "Throwable Highlighter",
      "properties": {
        "throwableHighlighter.classColor": {
          "type": "string",
          "default": "",
          "description": "Stored foreground color for Throwable types in the class context. Custom sources require HEX. With no explicit source, an empty value preserves native Java highlighting."
        },
        "throwableHighlighter.importColor": {
          "type": "string",
          "default": "",
          "description": "Stored foreground color for Throwable types in explicit imports. Custom sources require HEX. With no explicit source, an empty value inherits the class color."
        },
        "throwableHighlighter.catchColor": {
          "type": "string",
          "default": "",
          "description": "Stored foreground color for Throwable types in catch parameters. Custom sources require HEX. With no explicit source, an empty value inherits the class color."
        },
        "throwableHighlighter.throwsColor": {
          "type": "string",
          "default": "",
          "description": "Stored foreground color for Throwable types in throws clauses. Custom sources require HEX. With no explicit source, an empty value inherits the class color."
        },
        "throwableHighlighter.classColorSource": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "custom",
            "native"
          ],
          "default": null,
          "scope": "window",
          "description": "Color source for Throwable types in the class context. Null preserves the existing classColor rules."
        },
        "throwableHighlighter.importColorSource": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "custom",
            "inherit",
            "native"
          ],
          "default": null,
          "scope": "window",
          "description": "Color source for Throwable types in explicit imports. Null preserves the existing importColor rules."
        },
        "throwableHighlighter.catchColorSource": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "custom",
            "inherit",
            "native"
          ],
          "default": null,
          "scope": "window",
          "description": "Color source for Throwable types in catch parameters. Null preserves the existing catchColor rules."
        },
        "throwableHighlighter.throwsColorSource": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "custom",
            "inherit",
            "native"
          ],
          "default": null,
          "scope": "window",
          "description": "Color source for Throwable types in throws clauses. Null preserves the existing throwsColor rules."
        }
      }
    }
  },
  "scripts": {
    "compile": "node tooling/build/compile.cjs tsconfig.json",
    "build": "npm run compile && node tooling/build/package-vsix.cjs",
    "compile:test": "node tooling/build/compile.cjs tsconfig.test.json",
    "watch": "node tooling/build/watch.cjs tsconfig.json",
    "test:build": "node --test \"tooling/build/test/*.test.cjs\"",
    "test:tooling": "node --test \"tooling/build/test/*.test.cjs\" \"tooling/extension-host/test/*.test.mjs\" \"tooling/performance/test/*.test.mjs\"",
    "test": "npm run test:tooling && npm run compile:test && node --test \"out-test/test/**/*.test.js\"",
    "test:hierarchy": "npm run compile:test && node --test out-test/test/hierarchy/ThrowableHierarchyResolver.test.js",
    "check": "npm run format:check && npm run compile && npm test",
    "check:local": "npm run format:check:changed && npm run compile && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "node ../../.ci/check-format.cjs --changed",
    "format:check:tracked": "node ../../.ci/check-format.cjs --all",
    "check:browser:types": "tsc --project tsconfig.browser.json",
    "test:browser": "npm run check:browser:types && playwright test",
    "test:browser:report": "playwright show-report",
    "test:browser:visual": "npm run check:browser:types && playwright test --config playwright.visual.config.ts",
    "test:browser:container": "docker compose run --rm visual",
    "test:browser:visual:update": "npm run test:browser:visual -- --update-snapshots=all",
    "compile:extension-host": "node tooling/build/compile.cjs tsconfig.extension-host.json",
    "test:extension-host": "npm run compile && npm run compile:extension-host && node tooling/extension-host/run.mjs",
    "benchmark:refresh": "npm run compile:test && node out-test/test/performance/refresh.benchmark.js",
    "research:archive": "node tooling/performance/create-resource-archive.mjs",
    "research:charts": "node tooling/performance/render-research-charts.mjs"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "1.64.1",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "echarts": "6.1.0",
    "prettier": "3.9.10",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "^5.7.3"
  }
}
