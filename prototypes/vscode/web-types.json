{
  "$schema": "https://raw.githubusercontent.com/JetBrains/web-types/master/schema/web-types.json",
  "name": "throwable-highlighter-vscode-prototype",
  "version": "0.0.0",
  "contributions": {
    "css": {
      "properties": [
        {"name": "--vscode-button-background", "description": "Фоновый цвет основных кнопок."},
        {"name": "--vscode-button-border", "description": "Цвет границы кнопок."},
        {"name": "--vscode-button-foreground", "description": "Цвет текста основных кнопок."},
        {"name": "--vscode-button-secondaryBackground", "description": "Фоновый цвет второстепенных кнопок."},
        {
          "name": "--vscode-contrastBorder",
          "description": "Цвет дополнительных границ для повышения контрастности элементов."
        },
        {"name": "--vscode-descriptionForeground", "description": "Цвет вспомогательного текста и пояснений."},
        {"name": "--vscode-disabledForeground", "description": "Цвет текста недоступных элементов интерфейса."},
        {"name": "--vscode-editor-background", "description": "Фоновый цвет редактора, используемый как фон панели."},
        {
          "name": "--vscode-editor-font-family",
          "description": "Семейство шрифта редактора из настройки editor.fontFamily."
        },
        {"name": "--vscode-editorWidget-background", "description": "Фоновый цвет виджетов редактора."},
        {"name": "--vscode-editorWidget-foreground", "description": "Цвет текста виджетов редактора."},
        {"name": "--vscode-errorForeground", "description": "Цвет сообщений об ошибках."},
        {"name": "--vscode-focusBorder", "description": "Цвет рамки элемента, получившего фокус."},
        {"name": "--vscode-font-family", "description": "Семейство шрифта интерфейса VS Code."},
        {"name": "--vscode-font-size", "description": "Размер шрифта интерфейса VS Code."},
        {"name": "--vscode-foreground", "description": "Основной цвет текста интерфейса VS Code."},
        {"name": "--vscode-panel-border", "description": "Цвет границы панели VS Code."},
        {"name": "--vscode-textCodeBlock-background", "description": "Фоновый цвет блоков кода."}
      ]
    }
  }
}
