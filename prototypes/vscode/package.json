{
  "name": "throwable-highlighter-vscode-prototype",
  "displayName": "Throwable Highlighter VS Code Prototype",
  "description": "Technical prototype of Throwable Highlighter for VS Code.",
  "version": "0.0.0",
  "private": true,
  "publisher": "hedgerock",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onCommand:throwableHighlighter.prototype.inspectDefinition"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "throwableHighlighter.prototype.inspectDefinition",
        "title": "Throwable Highlighter Prototype: Inspect Definition"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "throwableHighlighter.prototype.inspectDefinition",
          "when": "editorLangId == java"
        }
      ]
    },
    "configuration": {
      "title": "Throwable Highlighter Prototype",
      "properties": {
        "throwableHighlighter.prototype.classColor": {
          "type": "string",
          "default": "",
          "description": "Foreground color for Throwable types. Leave empty to preserve the native Java class color."
        },
        "throwableHighlighter.prototype.importColor": {
          "type": "string",
          "default": "",
          "description": "Foreground color for Throwable types in explicit imports. Leave empty to inherit the class color."
        },
        "throwableHighlighter.prototype.catchColor": {
          "type": "string",
          "default": "",
          "description": "Foreground color for Throwable types in catch parameters. Leave empty to inherit the class color."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "check": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.85.0",
    "typescript": "^5.7.3"
  }
}