{
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "bracketSpacing": false,
  "arrowParens": "avoid",
  "printWidth": 120,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrderTypeScriptVersion": "5.9.3",
  "importOrder": [
    "^node:",
    "<BUILTIN_MODULES>",
    "<TYPES>^node:",
    "",
    "<THIRD_PARTY_MODULES>",
    "<TYPES>",
    "",
    "^@throwable-highlighter/",
    "<TYPES>^@throwable-highlighter/",
    "",
    "^[.]",
    "<TYPES>^[.]"
  ]
}
